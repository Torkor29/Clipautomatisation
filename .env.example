# Copier en .env sur le serveur (jamais commité)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
POST_FOR_ME_API_KEY=
# Mot de passe de l'interface web (fortement conseillé sur un VPS)
APP_PASSWORD=
# Front sur Vercel : nom de domaine https du VPS (ex. 1-2-3-4.sslip.io = ton IP avec des tirets)
DOMAIN=
# Origines autorisées à appeler l'API (ex. https://clipauto.vercel.app). * = toutes
CORS_ORIGINS=*
# Monteur IA (optionnel) — une seule clé suffit selon le fournisseur choisi dans Réglages
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
VERTEX_API_KEY=
# (optionnel) id du projet Google Cloud si la clé l'exige
VERTEX_PROJECT=
OPENAI_API_KEY=
